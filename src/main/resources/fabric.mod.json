{
  "schemaVersion": 1,
  "id": "litematica_auto_printer",
  "version": "${version}",
  "name": "Lithium",
  "description": "Lithium is free and open-source optimization mod for Minecraft which makes a wide range of performance improvements to the game.",
  "authors": [ "Jellysquid" ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [ "com.autoprinter.LitematicaAutoPrinter" ],
    "client": [ "com.autoprinter.LitematicaAutoPrinterClient" ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "litematica": "*",
    "malilib": "*"
  }
}
